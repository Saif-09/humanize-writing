# Set ONE of these (first match wins, in this order).
# Vercel AI Gateway key (needs a card on the Vercel account). On Vercel, OIDC is used automatically.
# AI_GATEWAY_API_KEY=
# Anthropic API key (https://platform.claude.com). Uses Claude directly.
ANTHROPIC_API_KEY=
# Free, no card: Google AI Studio key (https://aistudio.google.com/apikey). Uses Gemini directly.
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides (gateway "provider/model" ids)
# REWRITER_MODEL=anthropic/claude-haiku-5-5   (gateway ids use dots: anthropic/claude-haiku-5.5)
# JUDGE_MODEL=anthropic/claude-haiku-5-5

# Optional: the fine-tuned humanizer from ml/, on an OpenAI-compatible server
# (mlx_lm.server locally, vLLM in production). Takes over the main rewrite.
# FINETUNED_BASE_URL=http://<m2-ip>:8080/v1
# FINETUNED_MODEL=models/humanizer
# FINETUNED_API_KEY=

# Optional: self-hosted classifier for detector V2.
# POST { sentences: string[] } -> { scores: number[] }
# DETECTOR_URL=
# DETECTOR_API_KEY=
